---
import SiteAnalytics from "../components/SiteAnalytics.astro";
// Original homepage presentation preserved; factual source: Apex's official
// homepage/contact/pricing pages, checked 4 October 2026. Clients across Delhi.
const title = "Tattoo Studio in Delhi | Delhi Tattoo Shop by Apex Tattooz";
const description = "Explore tattoo work, discuss your idea with Apex Tattooz and plan your visit from anywhere in Delhi. Studio: Shop No. 52, Mall Road, GTB Nagar.";
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "TattooParlor",
  "@id": "https://www.delhitattooshop.com/#studio",
  "name": "Apex Tattooz",
  "url": "https://www.delhitattooshop.com/",
  "parentOrganization": {
    "@type": "Organization",
    "@id": "https://apextattooz.com/#organization",
    "name": "Apex Tattooz",
    "url": "https://apextattooz.com/"
  },
  "telephone": "+917217665761",
  "email": "contact@apextattooz.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Shop No. 52, Basement, Mall Road, Kingsway Camp, Near Metro Gate No. 3",
    "addressLocality": "GTB Nagar",
    "addressRegion": "Delhi",
    "postalCode": "110009",
    "addressCountry": "IN"
  },
  "areaServed": {
    "@type": "City",
    "name": "Delhi"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="tattoo studio Delhi, tattoo artist Delhi NCR, tattoo price in Delhi, cover up tattoo, fine line tattoo, realism tattoo Delhi, portrait tattoo Delhi, traditional tattoo Delhi, minimalist tattoo Delhi, custom tattoo design Delhi, tattoo artists Delhi, Delhi NCR tattoo shop">

  <!-- Google Search Console Verification -->

  <!-- Local Business SEO Meta Tags -->
  <meta name="geo.region" content="IN-DL">
  <meta name="geo.placename" content="GTB Nagar, New Delhi, Delhi, India">
  <meta name="business:contact_data:street_address" content="Shop No. 52, Basement, Mall Road, Kingsway Camp, Near Metro Gate No. 3">
  <meta name="business:contact_data:locality" content="GTB Nagar">
  <meta name="business:contact_data:region" content="New Delhi">
  <meta name="business:contact_data:postal_code" content="110009">
  <meta name="business:contact_data:country_name" content="India">
  <meta name="business:contact_data:phone_number" content="+91-721-766-5761">

  <!-- Enhanced SEO Meta Tags -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow">
  <meta name="bingbot" content="index, follow">
  <meta name="language" content="en">
  <meta name="revisit-after" content="7 days">
  <meta name="rating" content="general">
  <meta name="distribution" content="global">
  <meta name="coverage" content="Worldwide">
  <meta name="target" content="all">
  <meta name="HandheldFriendly" content="True">
  <meta name="MobileOptimized" content="320">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

  <!-- Canonical and Social Meta -->
  <link rel="canonical" href="https://www.delhitattooshop.com/">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://www.delhitattooshop.com/artists/photos/maddy-profile.jpg">
  <meta property="og:url" content="https://www.delhitattooshop.com/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://www.delhitattooshop.com/artists/photos/maddy-profile.jpg">

  <!-- Preconnect for Performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">

  <!-- Retained for the owner's existing Search Console GTM verification. -->
  <script src="/gtm.js" is:inline></script>
  <SiteAnalytics />


  <!-- Core Web Vitals Optimization -->
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="dark light">

  <!-- Local Business Structured Data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

<style>
    :root {
      --glass-bg: rgba(18, 18, 18, 0.06);
      --glass-border: rgba(255,255,255,0.08);
      --glass-blur: 20px;
      --max-width: 1150px;
      --accent-white: rgba(255,255,255,0.95);
      --accent-white2: rgba(255,255,255,0.70);
    }
    
    #apex-page {
      --bg: #0f0f0f;
      --panel: rgba(255,255,255,0.06);
      --border: rgba(255,255,255,0.12);
      --text: #fff;
      --muted: #d1d1d1;
      --glass-radius: 18px;
      --blur: 14px;
      --container: 1200px;
      --accent-primary: rgba(255,255,255,0.9);
      --accent-hover: rgba(255,255,255,0.15);
    }
    
    #apex-page *, #apex-page *::before, #apex-page *::after {
      box-sizing: border-box;
    }
    
    #apex-page {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'Poppins', sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
      font-size: 16px;
    }
    
    #apex-page a {
      color: inherit;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    
    #apex-page .container {
      max-width: var(--container);
      margin: 0 auto;
      padding: 0 20px;
    }
    
    /* Header Styles */
    .header-outer { 
      display: flex; 
      justify-content: center; 
      width: 100%; 
      margin: 0 auto;
      position: relative;
    }
    
    .top-section-container {
      position: relative;
      width: 100%;
      height: calc(100vh + 100px);
      overflow: hidden;
    }
    
    .top-section-video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -2;
      opacity: 1;
    }
    
    .top-section-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(0,0,0,0.2), rgba(0,0,0,0.1));
      z-index: -1;
    }
    
    .apex-header {
      position: sticky; 
      top: 12px; 
      z-index: 99;
      display: flex; 
      justify-content: center; 
      width: 100%;
      background: none; 
      pointer-events: none;
      overflow: hidden;
      border-radius: 999px;
    }
    
    .glass-header {
      width: 100%; 
      max-width: var(--max-width);
      display: flex; 
      align-items: center; 
      justify-content: space-between;
      gap: 20px; 
      padding: 14px 28px;
      border-radius: 999px;
      background: 
        linear-gradient(135deg, rgba(255,255,255,0.012), rgba(255,255,255,0.006)),
        radial-gradient(circle at 20% 50%, rgba(255,255,255,0.008), transparent 60%);
      border: 1px solid rgba(255,255,255,0.025);
      backdrop-filter: blur(15px);
      box-shadow: 
        0 0 0 1px rgba(255,255,255,0.04),
        0 20px 60px rgba(0,0,0,0.25),
        0 8px 30px rgba(0,0,0,0.15),
        inset 0 1px 0 rgba(255,255,255,0.08),
        inset 0 -1px 0 rgba(255,255,255,0.01);
      pointer-events: auto; 
      position: relative;
      overflow: hidden;
    }
    
    .glass-header:before {
      content: '';
      position: absolute;
      top: -1px;
      left: -50%;
      width: 200%;
      height: calc(100% + 2px);
      background: linear-gradient(90deg, 
                  transparent, 
                  rgba(255,255,255,0.06) 50%, 
                  transparent);
      border-radius: 999px;
      opacity: 0.7;
      animation: shimmer 3s ease-in-out infinite;
      pointer-events: none;
    }
    
    @keyframes shimmer {
      0%, 100% { transform: translateX(-100%); }
      50% { transform: translateX(100%); }
    }
    
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
      font-size: 18px;
      color: var(--text);
    }
    
    .header-nav {
      display: flex;
      gap: 28px;
    }
    
    .header-nav a {
      font-weight: 500;
      font-size: 15px;
      color: rgba(255,255,255,0.8);
      transition: all 0.2s ease;
    }
    
    .header-nav a:hover {
      color: rgba(255,255,255,1);
    }
    
    .menu-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      flex-direction: column;
      gap: 4px;
      padding: 8px;
    }
    
    .menu-toggle span {
      width: 20px;
      height: 2px;
      background: rgba(255,255,255,0.8);
      transition: all 0.3s ease;
    }
    
    @media (max-width: 768px) {
      .header-nav {
        display: none;
      }
      
      .menu-toggle {
        display: flex;
        flex: 0 0 auto;
        min-width: 44px;
        min-height: 44px;
        align-items: center;
        justify-content: center;
      }

      .glass-header {
        gap: 12px;
        padding: 14px 20px;
        flex-wrap: wrap;
        max-height: calc(100dvh - 24px);
        overflow-y: auto;
      }

      .brand {
        flex: 1;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .menu-toggle {
        order: 2;
      }

      .glass-header.menu-open {
        border-radius: var(--glass-radius);
      }

      .header-nav {
        order: 3;
        flex-basis: 100%;
      }

      .glass-header.menu-open .header-nav {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .header-nav a {
        display: block;
        padding: 12px 8px;
      }

      .apex-header {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        z-index: 1000 !important;
        padding: 12px 0 !important;
        border-radius: 0;
      }
      
      .top-section-container {
        padding-top: 100px;
        min-height: 100svh;
        height: auto;
      }

      #apex-page section[id] {
        scroll-margin-top: 100px;
      }
    }
    
    /* Liquid Background Animation */
    .liquid-bg {
      position: fixed;
      inset: -20% -8% -20% -8%;
      z-index: -3;
      pointer-events: none;
      filter: blur(36px) saturate(120%);
    }
    
    .blob {
      width: 480px;
      height: 480px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.14), rgba(255,255,255,0.02) 60%, transparent 72%);
      opacity: 0.22;
      position: absolute;
      animation: float 18s ease-in-out infinite;
    }
    
    .b1 { left: -6%; top: 0; }
    .b2 { right: -10%; top: 18%; animation-delay: -6s; }
    .b3 { left: 36%; bottom: -14%; animation-delay: -12s; }
    
    @keyframes float {
      0%, 100% { transform: translate3d(0,0,0); }
      50% { transform: translate3d(0,-18px,0) scale(1.02); }
    }
    
    /* Hero Section */
    .hero-wrap {
      position: relative;
      min-height: 100vh;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    
    .glass-hero {
      position: relative;
      z-index: 1;
      text-align: center;
      max-width: 900px;
      padding: 60px 50px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 16px;
      backdrop-filter: blur(20px);
      box-shadow: 
        0 8px 32px rgba(0,0,0,0.2),
        inset 0 1px 0 rgba(255,255,255,0.1);
      animation: gentleFloat 8s ease-in-out infinite;
    }
    
    @keyframes gentleFloat {
      0%, 100% { 
        transform: translateY(0px) scale(1);
      }
      50% { 
        transform: translateY(-4px) scale(1.002);
      }
    }
    
    .hero-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(36px, 5.5vw, 54px);
      font-weight: 300;
      margin: 0 0 20px;
      letter-spacing: 0.02em;
      line-height: 1.2;
      background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(255,255,255,0.7));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      filter: drop-shadow(0 6px 20px rgba(0,0,0,0.9)) 
              drop-shadow(0 2px 8px rgba(0,0,0,0.8)) 
              drop-shadow(0 0 40px rgba(0,0,0,0.6));
      animation: shadowPulse 4s ease-in-out infinite;
    }
    
    @keyframes shadowPulse {
      0%, 100% {
        filter: drop-shadow(0 6px 20px rgba(0,0,0,0.9)) 
                drop-shadow(0 2px 8px rgba(0,0,0,0.8)) 
                drop-shadow(0 0 40px rgba(0,0,0,0.6));
      }
      50% {
        filter: drop-shadow(0 8px 25px rgba(0,0,0,0.95)) 
                drop-shadow(0 3px 12px rgba(0,0,0,0.85)) 
                drop-shadow(0 0 50px rgba(0,0,0,0.7));
      }
    }
    
    .hero-sub {
      font-size: 19px;
      margin: 0 0 48px;
      color: rgba(255,255,255,0.85);
      line-height: 1.6;
      font-weight: 400;
      letter-spacing: 0.015em;
      text-shadow: 0 6px 18px rgba(0,0,0,0.9), 
                   0 2px 8px rgba(0,0,0,0.8), 
                   0 0 30px rgba(0,0,0,0.7);
    }
    
    .badges {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
      gap: 16px;
      margin: 42px 0 52px 0;
    }
    
    .badge {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px 20px;
      background: 
        linear-gradient(135deg, rgba(255,255,255,0.008), rgba(255,255,255,0.004));
      border: 1px solid rgba(255,255,255,0.015);
      border-radius: 16px;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-shadow: 0 2px 8px rgba(0,0,0,0.7);
      backdrop-filter: blur(8px);
      transition: all 0.3s ease;
      box-shadow: 
        0 8px 24px rgba(0,0,0,0.1),
        inset 0 1px 0 rgba(255,255,255,0.03);
    }
    
    .badge:hover {
      background: 
        linear-gradient(135deg, rgba(255,255,255,0.015), rgba(255,255,255,0.008));
      border-color: rgba(255,255,255,0.025);
      transform: translateY(-2px);
      box-shadow: 
        0 12px 30px rgba(0,0,0,0.15),
        inset 0 1px 0 rgba(255,255,255,0.05);
    }
    
    .hero-ctas {
      display: flex;
      gap: 24px;
      justify-content: center;
      flex-wrap: wrap;
      margin: 52px 0 42px 0;
    }
    
    .btn-solid {
      position: relative;
      padding: 16px 32px;
      background: linear-gradient(135deg, 
                  rgba(255,255,255,0.95), 
                  rgba(255,255,255,0.85));
      color: #000;
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 50px;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: 0.01em;
      transition: all 0.3s ease;
      box-shadow: 
        0 8px 20px rgba(0,0,0,0.15),
        inset 0 1px 0 rgba(255,255,255,0.2);
      cursor: pointer;
      display: inline-block;
    }
    
    .btn-solid:hover {
      transform: translateY(-2px);
      box-shadow: 
        0 12px 30px rgba(0,0,0,0.2),
        inset 0 1px 0 rgba(255,255,255,0.3);
      background: linear-gradient(135deg, 
                  rgba(255,255,255,1), 
                  rgba(255,255,255,0.9));
    }
    
    .btn-secondary {
      background: rgba(255,255,255,0.05);
      color: rgba(255,255,255,0.9);
      border: 1px solid rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
    }
    
    .btn-secondary:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.15);
      color: rgba(255,255,255,1);
    }
    
    .hero-supporting-info {
      margin-top: 42px;
      text-align: left;
      max-width: 700px;
    }
    
    .hero-info-line {
      font-size: 15px;
      color: rgba(255,255,255,0.7);
      margin-bottom: 8px;
      text-shadow: 0 2px 8px rgba(0,0,0,0.6);
    }
    
    /* Section Styles */
    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(32px, 4vw, 44px);
      font-weight: 700;
      text-align: center;
      margin: 80px 0 16px;
      letter-spacing: 0.01em;
      line-height: 1.2;
    }
    
    .section-sub {
      text-align: center;
      font-size: 18px;
      color: rgba(255,255,255,0.8);
      max-width: 600px;
      margin: 0 auto 48px;
      line-height: 1.6;
    }
    
    /* Glass Panel */
    .glass-panel {
      background: linear-gradient(135deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border-radius: 20px;
      padding: 40px;
      margin-bottom: 40px;
      border: 1px solid var(--border);
      backdrop-filter: blur(10px);
    }
    
    /* Artist Grid */
    .artist-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
      gap: 24px;
      margin-top: 32px;
    }
    
    .artist-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 24px;
      text-align: center;
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }
    
    .artist-card:hover {
      transform: translateY(-4px);
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.12);
      box-shadow: 0 12px 30px rgba(0,0,0,0.2);
    }
    
    .artist-avatar {
      width: 160px;
      height: 160px;
      border-radius: 50%;
      object-fit: cover;
      margin: 0 auto 16px;
      display: block;
      border: 2px solid rgba(255,255,255,0.1);
    }
    
    .artist-name {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 8px;
      color: rgba(255,255,255,0.95);
    }
    
    .artist-specialty {
      font-size: 14px;
      color: rgba(255,255,255,0.7);
      margin: 0 0 4px;
    }
    
    .artist-experience {
      font-size: 13px;
      color: rgba(255,255,255,0.6);
    }

    .artist-info {
      margin: 12px 0;
      padding: 12px 0;
      border-top: 1px solid rgba(255,255,255,0.1);
    }

    .artist-bio {
      font-size: 13px;
      color: rgba(255,255,255,0.7);
      line-height: 1.4;
      margin: 8px 0;
    }

    .artist-price {
      font-size: 14px;
      color: rgba(255,255,255,0.8);
      font-weight: 500;
      margin: 8px 0;
    }

    .artist-contact {
      display: flex;
      gap: 8px;
      justify-content: center;
      margin-top: 12px;
    }

    .contact-btn {
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
      transition: all 0.2s ease;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.05);
      color: rgba(255,255,255,0.8);
    }

    .contact-btn:hover {
      background: rgba(255,255,255,0.1);
      color: rgba(255,255,255,1);
      transform: translateY(-1px);
    }
    
    /* Feature Grid */
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
      gap: 32px;
    }
    
    .feature-card {
      text-align: center;
    }
    
    .feature-card h3 {
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 12px;
      color: rgba(255,255,255,0.95);
    }
    
    .feature-card p {
      font-size: 16px;
      color: rgba(255,255,255,0.8);
      line-height: 1.6;
    }

    /* Pricing Section */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
      gap: 24px;
      margin-top: 32px;
    }

    .pricing-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      padding: 32px 24px;
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .pricing-card:hover {
      transform: translateY(-4px);
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.12);
      box-shadow: 0 12px 30px rgba(0,0,0,0.2);
    }

    .pricing-card.popular {
      border-color: rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.04);
    }

    .pricing-card.popular::before {
      content: 'Detailed Tier';
      position: absolute;
      top: 16px;
      right: -32px;
      background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.7));
      color: #000;
      padding: 4px 40px;
      font-size: 12px;
      font-weight: 600;
      transform: rotate(45deg);
    }

    .price-tier {
      font-size: 14px;
      color: rgba(255,255,255,0.7);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }

    .price-amount {
      font-size: 36px;
      font-weight: 700;
      color: rgba(255,255,255,0.95);
      margin: 0 0 4px;
    }

    .price-unit {
      font-size: 14px;
      color: rgba(255,255,255,0.6);
      margin-bottom: 24px;
