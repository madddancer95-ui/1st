---
// Existing page: consultation questions for Delhi clients concerned about discomfort.
// Preserve the original production layout; omit unsupported pain ratings, client
// stories and medical advice. Related pages: Apex consultation and price guide.
const title = 'Worried About Tattoo Discomfort? Plan Your Consultation | Delhi Tattoo Shop';
const description = 'Questions to discuss with your tattoo artist about placement, size, session length and breaks. Plan a consultation with Apex Tattooz in Delhi.';
const canonical = 'https://www.delhitattooshop.com/tattoo-pain-guide-delhi';
const whatsappUrl = `https://wa.me/917217665761?text=${encodeURIComponent('Hi Apex Tattooz, I am considering a tattoo and would like to discuss the design, placement, session length and breaks before booking a consultation.')}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@type': 'WebSite', name: 'Delhi Tattoo Shop', url: 'https://www.delhitattooshop.com/' },
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
  <script src="/gtm.js" is:inline></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JDGJB534KV" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JDGJB534KV');
  </script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: 'Poppins', sans-serif;
      line-height: 1.6;
      color: #333;
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
      color: #ffffff;
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }
    
    .hero {
      background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
      padding: 80px 0;
      text-align: center;
    }
    
    .hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
    
    .hero p {
      font-size: 1.2rem;
      opacity: 0.9;
      max-width: 600px;
      margin: 0 auto;
    }
    
    .section {
      padding: 60px 0;
    }
    
    .section h2 {
      font-size: 2.5rem;
      margin-bottom: 2rem;
      text-align: center;
      color: #DAA520;
    }
    
    .content-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
      margin: 3rem 0;
    }
    
    .pain-chart {
      background: rgba(255,255,255,0.05);
      border-radius: 15px;
      padding: 2rem;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.1);
    }
    
    .pain-level {
      display: flex;
      align-items: center;
      padding: 1rem;
      margin: 1rem 0;
      border-radius: 10px;
      border-left: 5px solid;
    }
    
    .pain-level-1 { border-left-color: #28a745; background: rgba(40,167,69,0.1); }
    .pain-level-2 { border-left-color: #ffc107; background: rgba(255,193,7,0.1); }
    .pain-level-3 { border-left-color: #fd7e14; background: rgba(253,126,20,0.1); }
    .pain-level-4 { border-left-color: #dc3545; background: rgba(220,53,69,0.1); }
    .pain-level-5 { border-left-color: #6f42c1; background: rgba(111,66,193,0.1); }
    
    .pain-scale {
      font-size: 2rem;
      font-weight: bold;
      margin-right: 1rem;
      width: 60px;
    }
    
    .experience-box {
      background: linear-gradient(135deg, rgba(218,165,32,0.1), rgba(139,69,19,0.1));
      border-radius: 15px;
      padding: 2rem;
      margin: 2rem 0;
      border-left: 4px solid #DAA520;
    }
    
    .tip-box {
      background: rgba(72,201,176,0.1);
      border-radius: 15px;
      padding: 2rem;
      margin: 2rem 0;
      border-left: 4px solid #48C9B0;
    }
    
    .cta-section {
      background: linear-gradient(135deg, #8B4513, #A0522D);
      padding: 60px 0;
      text-align: center;
      margin: 3rem 0;
      border-radius: 20px;
    }
    
    .btn {
      display: inline-block;
      padding: 15px 30px;
      margin: 10px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }
    
    .btn-primary {
      background: linear-gradient(135deg, #28a745, #20c997);
      color: white;
    }
    
    .btn-secondary {
      background: transparent;
      color: white;
      border: 2px solid white;
    }
    
    @media (max-width: 768px) {
      .hero h1 { font-size: 2rem; }
      .section h2 { font-size: 2rem; }
      .pain-scale { font-size: 1.5rem; }
    }
  </style>
</head>
<body>
  <main id="main">
    <section class="hero" aria-labelledby="page-title">
      <div class="container">
        <h1 id="page-title">Worried About Tattoo Discomfort?</h1>
        <p>Plan a conversation with Apex Tattooz about your design, placement and session before booking.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Bring Your Questions to the Consultation</h2>
        <div class="experience-box">
          <h3>Tell your artist what concerns you.</h3>
          <p>Ask the artist to explain the appointment, discuss your design and agree how you will communicate during the session. You can clarify the plan before deciding on an appointment.</p>
        </div>

        <h2 id="questions-heading">Five Things to Talk Through</h2>
        <div class="pain-chart" aria-labelledby="questions-heading">
          <p style="margin-bottom: 2rem; font-style: italic;">These are conversation prompts, not pain ratings. Keep them handy when you speak with your artist.</p>
          <div class="pain-level pain-level-1">
            <div class="pain-scale" aria-hidden="true">01</div>
            <div><h3>Placement, Size and Detail</h3><p>Show the artist your references, preferred placement and approximate width and height. Ask whether the design needs more space or a different approach at that placement.</p><p><strong>Ask:</strong> Can we compare size and placement options before I decide?</p></div>
          </div>
          <div class="pain-level pain-level-2">
            <div class="pain-scale" aria-hidden="true">02</div>
            <div><h3>The Session Plan</h3><p>Ask what the appointment will involve, how much time to set aside and whether the project may need more than one session.</p><p><strong>Ask:</strong> What happens from the design discussion to the end of the appointment?</p></div>
          </div>
          <div class="pain-level pain-level-3">
            <div class="pain-scale" aria-hidden="true">03</div>
            <div><h3>Breaks and Communication</h3><p>Discuss breaks before the session begins. Agree how to ask the artist to pause and how you will let them know if you want to stop or reconsider.</p><p><strong>Ask:</strong> How should I ask for a break, and how will we decide when to continue?</p></div>
          </div>
          <div class="pain-level pain-level-4">
            <div class="pain-scale" aria-hidden="true">04</div>
            <div><h3>Your Questions and Boundaries</h3><p>Tell the artist which part of the appointment concerns you. Ask for an explanation of anything unfamiliar before agreeing to the design and session plan.</p><p><strong>Ask:</strong> Could you talk me through the part I am unsure about?</p></div>
          </div>
          <div class="pain-level pain-level-5">
            <div class="pain-scale" aria-hidden="true">05</div>
            <div><h3>The Next Step</h3><p>Ask the studio to confirm your design discussion, quote and appointment details before you book.</p><p><strong>Ask:</strong> What do I need to confirm before choosing an appointment?</p></div>
          </div>
        </div>

        <h2 id="bring-heading">Bring Your Idea and Your Questions</h2>
        <div class="tip-box">
          <h3>A Starting Point for the Artist</h3>
          <ul style="margin: 1rem 0; line-height: 2; list-style-position: inside;">
            <li>Reference images and the styles you are considering</li>
            <li>Your preferred placement and approximate dimensions</li>
            <li>Your budget and available dates</li>
            <li>The questions you want to discuss before booking</li>
          </ul>
        </div>
        <div class="experience-box">
          <h3>Questions About Your Health</h3>
          <p>For questions about a health condition, medication or whether tattooing is suitable for you, speak with a qualified clinician before booking.</p>
        </div>

        <div class="cta-section" aria-labelledby="booking-heading">
          <h2 id="booking-heading">Start With a Conversation</h2>
          <p>Welcoming clients from across Delhi. Contact Apex Tattooz to discuss your idea and arrange a studio visit.</p>
          <div style="margin-top: 2rem;">
            <a href="tel:+917217665761" class="btn btn-primary"><i class="fas fa-phone" aria-hidden="true"></i> Call +91-721-766-5761</a>
            <a href={whatsappUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer"><i class="fab fa-whatsapp" aria-hidden="true"></i> Discuss Your Questions</a>
          </div>
          <p style="margin-top: 1rem; opacity: 0.9;"><a href="/visit-studio" style="color: white;">See the current studio address and visit details</a></p>
        </div>
      </div>
    </section>
  </main>
  <footer style="background: #1a1a1a; padding: 40px 0; text-align: center; border-top: 1px solid #333;">
    <div class="container">
      <p>© {new Date().getFullYear()} DelhiTattooShop.com · A website by Apex Tattooz · Serving Delhi</p>
      <p style="margin-top: 1rem;">
        <a href="/" style="color: #DAA520; text-decoration: none; margin: 0 10px;">Home</a>
        <a href="/artists" style="color: #DAA520; text-decoration: none; margin: 0 10px;">Artists</a>
        <a href="/pricing-calculator" style="color: #DAA520; text-decoration: none; margin: 0 10px;">Pricing</a>
        <a href="/visit-studio" style="color: #DAA520; text-decoration: none; margin: 0 10px;">Visit the studio</a>
      </p>
    </div>
  </footer>
</body>
</html>
